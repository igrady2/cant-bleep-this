# TypeSafe AI key for Jev moderation (required for posting messages).
TYPESAFE_API_KEY=

# Public Turnstile site key (build-time; inlined into the client bundle).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side Turnstile verification and salted IP hashing for name claims.
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
# TYPESAFE_MODEL=jev-latest
# MODERATION_THRESHOLD=0.5
# MODERATION_THRESHOLD_OFF_LIMITS=0.5

# Minimum digits masked in a run with spaces, hyphens, dots or parentheses.
# MASK_MIN_DIGITS=7

# Runtime review requirement tiers; below the first queueSize there is no requirement.
# Set the same JSON string in Worker environment variables to tune without a release.
# REVIEW_REQUIREMENT_TIERS=[{"queueSize":10,"posts":5},{"queueSize":50,"posts":3},{"queueSize":200,"posts":1}]
