{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./node_modules/server-only/empty.js"]
    }
  },
  "include": ["scripts/**/*.ts", "src/lib/seeds/**/*.ts", "src/lib/moderation/**/*.ts", "src/lib/filter-release/**/*.ts"]
}
